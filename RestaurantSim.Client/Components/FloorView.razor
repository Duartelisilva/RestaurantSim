@using System.Globalization
@using RestaurantSim.Client.State
@using RestaurantSim.Contracts.Snapshot

@if (Snapshot is { } s)
{
    var (cols, rows) = Extents(s.Floor);

    <svg class="floor" viewBox="0 0 @(cols * Cell) @(rows * Cell)" width="@(cols * Cell)" height="@(rows * Cell)">
        @foreach (var b in s.Floor.Bathrooms)
        {
            @Box("bathroom", b.Position, b.Size, $"WC {b.Gender[0]}")
        }
        @foreach (var st in s.Floor.Stations)
        {
            @Box("station", st.Position, st.Size, st.StationTypeId)
        }
        @foreach (var h in s.Floor.HeatLamps)
        {
            @Box("heatlamp", h.Position, h.Size, "lamp")
        }
        @foreach (var f in s.Floor.Freezers)
        {
            @Box("freezer", f.Position, f.Size, "freezer")
        }
        @foreach (var t in s.Floor.Tables)
        {
            var group = FloorLabels.DiningGroup(s, t);
            var css = "table state-" + StateOf(s.Floor, t).ToLowerInvariant()
                + (group is null ? "" : " " + DiningLabels.CssClass(group.Stage));
            var tooltip = group is null ? null : $"Group {group.GroupId} — {DiningLabels.Describe(group.Stage, group.NextVisit)}";
            @Box(css, t.Position, t.Size, $"T{t.TableId}", FloorLabels.Occupancy(s, t), tooltip, SlideOf(t))
        }
        @* Tables pushed together read as one table: outline them once they have arrived. *@
        @foreach (var cluster in s.Floor.Clusters.Where(c => c.TableIds.Count > 1 && c.State != "Moving"))
        {
            if (FloorLabels.ClusterBounds(s, cluster) is { } box)
            {
                <rect class="cluster-outline" x="@(box.X * Cell)" y="@(box.Y * Cell)" width="@(box.Width * Cell)" height="@(box.Height * Cell)">
                    <title>Merged table (@cluster.Capacity seats)</title>
                </rect>
            }
        }
        @* Staff: one small circle each, on the spot they stand on. *@
        @foreach (var st in s.Staff)
        {
            <g class="staff @StaffLabels.RoleClass(st.Role) @StaffLabels.StateClass(st.State)">
                <title>@StaffLabels.Summary(st)</title>
                <circle cx="@(st.Position.X * Cell + Cell / 2)" cy="@(st.Position.Y * Cell + Cell / 2)" r="@StaffRadius" />
                <text x="@(st.Position.X * Cell + Cell / 2)" y="@(st.Position.Y * Cell + Cell / 2)">@StaffLabels.Initial(st.Role)</text>
            </g>
        }
    </svg>
}

@code {
    private const int Cell = 40;
    private const int StaffRadius = 11;

    [Parameter]
    public RestaurantSnapshotDto? Snapshot { get; set; }

    // Tables currently sliding, by table id (RestaurantStore.Motions).
    [Parameter]
    public IReadOnlyDictionary<int, TableMotion>? Motions { get; set; }

    // Assumes Position is the top-left cell of the hitbox, Y growing downwards.
    private RenderFragment Box(string css, GridPointDto pos, GridSizeDto size, string label, string? detail = null, string? tooltip = null, string? slide = null) => @<g class="@(slide is null ? null : "table-slide")" style="@slide">
        <title>@tooltip</title>
        <rect class="@css" x="@(pos.X * Cell)" y="@(pos.Y * Cell)" width="@(size.Width * Cell)" height="@(size.Height * Cell)" />
        <text x="@(pos.X * Cell + 4)" y="@(pos.Y * Cell + 14)">@label</text>
        <text x="@(pos.X * Cell + 4)" y="@(pos.Y * Cell + 30)" font-weight="600">@detail</text>
    </g>;

    // The inline style of a sliding table: start offset (the old cell, relative to where the
    // table now is) and duration; the .table-slide animation moves it to offset zero.
    private string? SlideOf(TableDto table)
    {
        if (Motions is null || !Motions.TryGetValue(table.TableId, out var motion))
            return null;

        var dx = (motion.From.X - motion.To.X) * Cell;
        var dy = (motion.From.Y - motion.To.Y) * Cell;
        var seconds = motion.DurationSeconds.ToString("0.###", CultureInfo.InvariantCulture);
        return $"--dx:{dx}px;--dy:{dy}px;animation-duration:{seconds}s";
    }

    private static string StateOf(FloorDto floor, TableDto table)
    {
        return floor.Clusters.FirstOrDefault(c => c.ClusterId == table.ClusterId)?.State ?? "Free";
    }

    private static (int Cols, int Rows) Extents(FloorDto floor)
    {
        var cols = 1;
        var rows = 1;

        void Grow(GridPointDto p, GridSizeDto s)
        {
            cols = Math.Max(cols, p.X + s.Width);
            rows = Math.Max(rows, p.Y + s.Height);
        }

        foreach (var t in floor.Tables) Grow(t.Position, t.Size);
        foreach (var s in floor.Stations) Grow(s.Position, s.Size);
        foreach (var h in floor.HeatLamps) Grow(h.Position, h.Size);
        foreach (var f in floor.Freezers) Grow(f.Position, f.Size);
        foreach (var b in floor.Bathrooms) Grow(b.Position, b.Size);

        return (cols, rows);
    }
}
