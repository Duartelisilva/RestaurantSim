@page "/"
@implements IDisposable
@inject IEngineClient Engine
@inject RestaurantStore Store

<h1>RestaurantSim</h1>

<p>Status: @_status</p>

<button @onclick="StartAsync" disabled="@_started">Connect &amp; start default_diner</button>

@if (Store.Snapshot is { } snapshot && _clock is not null)
{
    <p>In-game time: @_clock.TimeOfDay(DateTimeOffset.UtcNow).ToString("HH:mm")</p>

    <div class="floor-layout">
        <FloorView Snapshot="snapshot" />

        <div class="side">
            <h3>Queue (@snapshot.Queue.Count)</h3>
            <ul>
                @foreach (var g in snapshot.Queue)
                {
                    <li>Group @g.GroupId — party of @g.PartySize</li>
                }
            </ul>

            <h3>Staff (as at join)</h3>
            <ul>
                @foreach (var st in snapshot.Staff)
                {
                    <li>@st.Name — @st.Role, @st.State</li>
                }
            </ul>

            <h3>Live events</h3>
            <ul>
                @foreach (var line in _log)
                {
                    <li>@line</li>
                }
            </ul>
        </div>
    </div>
}

@code {
    private string _status = "Not connected";
    private bool _started;
    private GameClock? _clock;
    private System.Threading.Timer? _timer;
    private readonly List<string> _log = new();

    protected override void OnInitialized()
    {
        Engine.GroupArrived += OnGroupArrived;
        Engine.GroupAbandonedQueue += OnGroupAbandonedQueue;
        Engine.GroupSeated += OnGroupSeated;
        Engine.GroupLeft += OnGroupLeft;
        Engine.TableCleaned += OnTableCleaned;
        Store.Changed += OnStoreChanged;
    }

    private async Task StartAsync()
    {
        _started = true;

        try
        {
            await Engine.ConnectAsync();
            _status = "Connected, creating restaurant...";

            var created = await Engine.CreateRestaurantAsync("default_diner");
            if (!created.Succeeded)
            {
                _status = $"Create failed: {created.Error}";
                _started = false;
                return;
            }

            var joined = await Engine.JoinRestaurantAsync(created.Value);
            if (joined is { Succeeded: true, Value: { } snapshot })
            {
                _clock = new GameClock(
                    snapshot.SimulationTick, snapshot.MinutesPerTick, snapshot.TicksPerRealSecond, DateTimeOffset.UtcNow);
                _timer = new System.Threading.Timer(
                    _ => InvokeAsync(StateHasChanged), null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
                Store.Load(snapshot);
                _status = "Joined";
            }
            else
            {
                _status = $"Join failed: {joined.Error}";
                _started = false;
            }
        }
        catch (Exception ex)
        {
            _status = $"Error: {ex.Message}";
            _started = false;
        }
    }

    private void OnGroupArrived(GroupArrivedDto dto)
    {
        if (Store.Apply(dto))
            _log.Add($"[tick {dto.Tick}] group {dto.GroupId} arrived (party of {dto.PartySize})");
    }

    private void OnGroupAbandonedQueue(GroupAbandonedQueueDto dto)
    {
        if (Store.Apply(dto))
            _log.Add($"[tick {dto.Tick}] group {dto.GroupId} left the queue");
    }

    private void OnGroupSeated(GroupSeatedDto dto)
    {
        if (Store.Apply(dto))
            _log.Add($"[tick {dto.Tick}] group {dto.GroupId} seated at cluster {dto.ClusterId}");
    }

    private void OnGroupLeft(GroupLeftDto dto)
    {
        if (Store.Apply(dto))
            _log.Add($"[tick {dto.Tick}] group {dto.GroupId} left cluster {dto.ClusterId}");
    }

    private void OnTableCleaned(TableCleanedDto dto)
    {
        if (Store.Apply(dto))
            _log.Add($"[tick {dto.Tick}] table {dto.TableId} cleaned");
    }

    private void OnStoreChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Engine.GroupArrived -= OnGroupArrived;
        Engine.GroupAbandonedQueue -= OnGroupAbandonedQueue;
        Engine.GroupSeated -= OnGroupSeated;
        Engine.GroupLeft -= OnGroupLeft;
        Engine.TableCleaned -= OnTableCleaned;
        Store.Changed -= OnStoreChanged;
        _timer?.Dispose();
    }
}
