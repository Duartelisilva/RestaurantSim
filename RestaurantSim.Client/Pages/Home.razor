@page "/"
@implements IDisposable
@inject EngineSession Session
@inject RestaurantStore Store

<h1>RestaurantSim</h1>

<p>Status: @Session.Status</p>

<button @onclick="StartAsync" disabled="@Session.IsStarted">Connect &amp; start default_diner</button>

@if (Session.CanReconnect)
{
    <button @onclick="Session.ReconnectAsync">Reconnect</button>
}

@if (Store.Snapshot is { } snapshot && Session.Clock is { } clock)
{
    <p>In-game time: @clock.TimeOfDay(DateTimeOffset.UtcNow).ToString("HH:mm")</p>

    <div class="floor-layout">
        <FloorView Snapshot="snapshot" />

        <div class="side">
            <h3>Queue (@snapshot.Queue.Count)</h3>
            <ul>
                @foreach (var g in snapshot.Queue)
                {
                    <li>Group @g.GroupId — party of @g.PartySize</li>
                }
            </ul>

            <h3>Staff (as at join)</h3>
            <ul>
                @foreach (var st in snapshot.Staff)
                {
                    <li>@st.Name — @st.Role, @st.State</li>
                }
            </ul>

            <h3>Live events</h3>
            <ul>
                @foreach (var line in Session.Log)
                {
                    <li>@line</li>
                }
            </ul>
        </div>
    </div>
}

@code {
    private System.Threading.Timer? _timer;

    protected override void OnInitialized()
    {
        Session.Changed += OnSessionChanged;

        // Re-render once a second so the extrapolated in-game clock keeps moving.
        _timer = new System.Threading.Timer(
            _ => InvokeAsync(StateHasChanged), null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    private Task StartAsync() => Session.StartAsync("default_diner");

    private void OnSessionChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Session.Changed -= OnSessionChanged;
        _timer?.Dispose();
    }
}
