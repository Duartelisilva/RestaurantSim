root = true

[*]
indent_style = space
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.cs]
indent_size = 4

# Nullable reference types are mandatory per CLAUDE.md — warnings must be
# treated as errors at the .csproj level (<WarningsAsErrors>Nullable</WarningsAsErrors>),
# but these analyzer IDs are set to error here too as a second guardrail.
dotnet_diagnostic.CS8600.severity = error
dotnet_diagnostic.CS8601.severity = error
dotnet_diagnostic.CS8602.severity = error
dotnet_diagnostic.CS8603.severity = error
dotnet_diagnostic.CS8604.severity = error
dotnet_diagnostic.CS8618.severity = error
dotnet_diagnostic.CS8625.severity = error

# Never suppress a nullable warning with the null-forgiving operator (!)
# as a shortcut — CLAUDE.md: prove it can't be null, or fix the entity doc.
dotnet_diagnostic.CS8714.severity = suggestion

# var usage — prefer explicit types for domain clarity (entities/records with
# meaningful type names), var is fine for obvious right-hand-side types.
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion

# Naming conventions — I prefix on interfaces (ISeatingStrategy, IRestaurantRepository)
dotnet_naming_rule.interfaces_start_with_i.severity = error
dotnet_naming_rule.interfaces_start_with_i.symbols = interface_symbol
dotnet_naming_rule.interfaces_start_with_i.style = i_prefix_style
dotnet_naming_symbols.interface_symbol.applicable_kinds = interface
dotnet_naming_style.i_prefix_style.required_prefix = I
dotnet_naming_style.i_prefix_style.capitalization = pascal_case

# Async methods must end in Async — CLAUDE.md convention, no exceptions
dotnet_naming_rule.async_methods_end_in_async.severity = warning
dotnet_naming_rule.async_methods_end_in_async.symbols = async_method_symbol
dotnet_naming_rule.async_methods_end_in_async.style = async_suffix_style
dotnet_naming_symbols.async_method_symbol.applicable_kinds = method
dotnet_naming_symbols.async_method_symbol.required_modifiers = async
dotnet_naming_style.async_suffix_style.required_suffix = Async
dotnet_naming_style.async_suffix_style.capitalization = pascal_case

# Standard PascalCase for types and members
dotnet_naming_rule.types_pascal_case.severity = error
dotnet_naming_rule.types_pascal_case.symbols = type_symbol
dotnet_naming_rule.types_pascal_case.style = pascal_case_style
dotnet_naming_symbols.type_symbol.applicable_kinds = class, struct, interface, enum, record
dotnet_naming_style.pascal_case_style.capitalization = pascal_case

dotnet_naming_rule.members_pascal_case.severity = warning
dotnet_naming_rule.members_pascal_case.symbols = member_symbol
dotnet_naming_rule.members_pascal_case.style = pascal_case_style
dotnet_naming_symbols.member_symbol.applicable_kinds = method, property, event

# Private fields — _camelCase, matches the underscore-free style already used
# throughout the entity doc's public fields; private backing fields get a
# leading underscore to visually separate them.
dotnet_naming_rule.private_fields_underscore_camel_case.severity = warning
dotnet_naming_rule.private_fields_underscore_camel_case.symbols = private_field_symbol
dotnet_naming_rule.private_fields_underscore_camel_case.style = underscore_camel_case_style
dotnet_naming_symbols.private_field_symbol.applicable_kinds = field
dotnet_naming_symbols.private_field_symbol.applicable_accessibilities = private
dotnet_naming_style.underscore_camel_case_style.required_prefix = _
dotnet_naming_style.underscore_camel_case_style.capitalization = camel_case

# Braces — Allman style (standard .NET/Visual Studio default)
csharp_new_line_before_open_brace = all

# Prefer expression-bodied members for simple one-liners only
csharp_style_expression_bodied_methods = false:suggestion
csharp_style_expression_bodied_properties = true:suggestion

# Usings outside namespace, System.* first
csharp_using_directive_placement = outside_namespace:warning
dotnet_sort_system_directives_first = true

# File-scoped namespaces (modern C#, less nesting/indentation noise)
csharp_style_namespace_declarations = file_scoped:warning

# Discourage null-forgiving operator shortcut per CLAUDE.md
dotnet_style_null_propagation = true:suggestion

# Readonly where possible — entity doc fields are largely immutable-by-design
# (e.g. Instability "fixed for the visit"), encourage that at the language level
dotnet_style_readonly_field = true:warning

[*.json]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
